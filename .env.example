# Copy to .env (next to meeting_recorder.py) and fill in what you need.
# Every line is optional; real environment variables win over this file.

# Where transcripts go (WAVs go in its recordings\ subfolder).
# TRANSCRIPTION_OUTPUT_DIR=C:\Users\you\Transcriptions

# Also drop a Markdown copy of each diarized transcript here (e.g. a notes inbox).
# TRANSCRIPTION_INBOX_DIR=C:\Users\you\Notes\inbox

# Language code sent to the server (the tray popup can override it per recording).
# TRANSCRIPTION_LANGUAGE=nl

# TranscriptionSuite's docker folder. Defaults to the dashboard's
# %APPDATA%\TranscriptionSuite\docker, else %USERPROFILE%\TranscriptionSuite\docker.
# TRANSCRIPTION_COMPOSE_DIR=C:\Users\you\TranscriptionSuite\docker

# Compose files to pass as -f, separated by ';'. Only needed when that folder's
# .env doesn't set COMPOSE_FILE (a manual checkout rather than the dashboard).
# TRANSCRIPTION_COMPOSE_FILES=docker-compose.yml;docker-compose.local.yml

# Hugging Face token for the diarization model, passed to the server on start.
# HF_TOKEN=hf_...
